# Build
FROM golang:1.26-alpine3.23 AS builder
ARG app

WORKDIR /build
COPY . .
RUN echo building app : ${app}
RUN go -C app/web/${app} build -o main 

# Alpine Linux 
FROM alpine:3.23

ARG app
RUN addgroup -S tarantula && adduser -S tarantula -G tarantula

RUN mkdir /home/tarantula/${app}

RUN chown -R tarantula /home/tarantula/${app}   

USER tarantula
WORKDIR /home/tarantula

RUN mkdir /home/tarantula/.ssh
WORKDIR /home/tarantula/.ssh
COPY --from=builder /build/id_ed25519 .
COPY --from=builder /build/known_hosts .
COPY --from=builder /build/.gitconfig .
COPY --from=builder /build/gx-01.json .
COPY --from=builder /build/gx-01.key .
COPY --from=builder /build/gx-01.key.pub .

# Application Install
WORKDIR /home/tarantula/bin
RUN echo installing app : ${app}
COPY --from=builder /build/app/web/${app}/main .
COPY --from=builder /build/app/web/${app}/*.json .

ENTRYPOINT ["./main"]